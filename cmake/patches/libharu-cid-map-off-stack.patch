+/*
+ * The map from Unicode to glyph ids has 65536 entries, 128 kB: allocated
+ * rather than kept on the stack, which in WebAssembly or on a small target may
+ * well be smaller than that, and overflows without a word.
+ */
+static HPDF_Font
+CIDFontType2_NewWithMap (HPDF_Font parent, HPDF_Xref xref, HPDF_UNICODE *tmp_map);
+
 static HPDF_Font
 CIDFontType2_New (HPDF_Font parent, HPDF_Xref xref)
 {
+    HPDF_UNICODE *tmp_map = (HPDF_UNICODE *)HPDF_GetMem (parent->mmgr,
+                    sizeof(HPDF_UNICODE) * 65536);
+    HPDF_Font font;
+
+    if (!tmp_map)
+        return NULL;
+
+    font = CIDFontType2_NewWithMap (parent, xref, tmp_map);
+    HPDF_FreeMem (parent->mmgr, tmp_map);
+    return font;
+}
+
+static HPDF_Font
+CIDFontType2_NewWithMap (HPDF_Font parent, HPDF_Xref xref, HPDF_UNICODE *tmp_map)
+{
